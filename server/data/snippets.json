    "title": "Binary Search in TypeScript",
    "description": "Standard binary search implementation",
    "language": "typescript",
    "code": "function binarySearch(arr: number[], target: number): number { let l = 0, r = arr.length - 1; while (l <= r) { const m = Math.floor((l + r) / 2); if (arr[m] === target) return m; if (arr[m] < target) l = m + 1; else r = m - 1; } return -1; }",
